meta {
  name: Update User Settings
  type: http
  seq: 9
  tags: [
    system
  ]
}

patch {
  url: {{baseUrl}}/api/v1/user-settings
  body: json
  auth: inherit
}

body:json {
  {
    "local_only_conversations": ""
  }
}

docs {
  Update current user's sync settings.
}

example {
  name: 200 Response
  description: Successful Response
  
  request: {
    url: {{baseUrl}}/api/v1/user-settings
    method: PATCH
    mode: json
    body:json: {
      {
        "local_only_conversations": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "local_only_conversations": false,
          "user_local_only_conversations": ""
        }
      '''
    }
  }
}

