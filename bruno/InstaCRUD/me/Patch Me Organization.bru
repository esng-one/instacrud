meta {
  name: Patch Me Organization
  type: http
  seq: 4
  tags: [
    me
  ]
}

patch {
  url: {{baseUrl}}/api/v1/me/organization
  body: json
  auth: inherit
}

body:json {
  {
    "name": "",
    "description": "",
    "local_only_conversations": ""
  }
}

docs {
  Update allowed organization fields for ORG_ADMIN.
  
  Omitting a field leaves it unchanged. Sending description as null or "" clears it.
}

example {
  name: 200 Response
  description: Successful Response
  
  request: {
    url: {{baseUrl}}/api/v1/me/organization
    method: PATCH
    mode: json
    body:json: {
      {
        "name": "",
        "description": "",
        "local_only_conversations": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "",
          "name": "",
          "code": "",
          "description": "",
          "local_only_conversations": false,
          "tier_id": ""
        }
      '''
    }
  }
}

example {
  name: 422 Response
  description: Validation Error
  
  request: {
    url: {{baseUrl}}/api/v1/me/organization
    method: PATCH
    mode: json
    body:json: {
      {
        "name": "",
        "description": "",
        "local_only_conversations": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
