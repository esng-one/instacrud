meta {
  name: Patch Me
  type: http
  seq: 2
  tags: [
    me
  ]
}

patch {
  url: {{baseUrl}}/api/v1/me
  body: json
  auth: inherit
}

body:json {
  {
    "name": ""
  }
}

docs {
  Update the currently authenticated user.
}

example {
  name: 200 Response
  description: Successful Response
  
  request: {
    url: {{baseUrl}}/api/v1/me
    method: PATCH
    mode: json
    body:json: {
      {
        "name": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "user": {
            "id": "",
            "email": "",
            "name": "",
            "role": "",
            "has_password": false
          },
          "organization": "",
          "usage": {
            "used": 0,
            "limit": "",
            "percentage": 0,
            "remaining": "",
            "reset_at": ""
          },
          "tier": ""
        }
      '''
    }
  }
}

example {
  name: 422 Response
  description: Validation Error
  
  request: {
    url: {{baseUrl}}/api/v1/me
    method: PATCH
    mode: json
    body:json: {
      {
        "name": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": [
            {
              "loc": [],
              "msg": "",
              "type": ""
            }
          ]
        }
      '''
    }
  }
}
